# --- Database ---
DATABASE_URL="postgresql://finsight:finsight@localhost:5432/finsight?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Sessions / Auth ---
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-64-char-random-hex-string"
SESSION_COOKIE_NAME="finsight_session"

# --- Web app ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AI_SERVICE_URL="http://localhost:8000"

# --- AI service (FastAPI) ---
AI_SERVICE_PORT=8000
OPENAI_API_KEY="replace-with-your-key"
ANTHROPIC_API_KEY="replace-with-your-key"

# --- Stripe ---
STRIPE_SECRET_KEY="replace-with-your-key"
STRIPE_PUBLISHABLE_KEY="replace-with-your-key"
STRIPE_WEBHOOK_SECRET="replace-with-your-key"

# --- Market data provider ---
MARKET_DATA_API_KEY="replace-with-your-key"
